{
  "realm": "campuslab",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 30,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Administra el catalogo de labs/equipos y ve KPIs de ocupacion." },
      { "name": "TECNICO", "description": "Aprueba reservas, prepara la sala y registra devoluciones." },
      { "name": "ESTUDIANTE", "description": "Solicita y sigue sus propias reservas." },
      { "name": "AUDITOR", "description": "Consulta el timeline. Solo lectura." }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Injects 'sub' into the access token (built-in scope, redefined explicitly for the same reason 'roles' below is: a full realm import does not auto-create Keycloak's default scopes). Without this, GET /api/me has no subject to return.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Adds preferred_username/name (built-in scope, redefined explicitly for the same reason 'roles' below is)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "Adds email (built-in scope, redefined explicitly for the same reason 'roles' below is)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Maps realm and client roles into the token (built-in scope, redefined explicitly because a full realm import does not auto-create Keycloak's default scopes)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "campuslab-api-audience",
      "description": "Adds campuslab-api as a token audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "campuslab-api-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "campuslab-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "campuslab-spa",
      "name": "CampusLab SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "defaultClientScopes": ["basic", "profile", "email", "roles", "campuslab-api-audience"]
    },
    {
      "clientId": "campuslab-api",
      "name": "CampusLab API audience",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "admin.test",
      "enabled": true,
      "emailVerified": true,
      "email": "admin.test@campuslab.local",
      "firstName": "Admin",
      "lastName": "Test",
      "credentials": [{ "type": "password", "value": "Campuslab#2026", "temporary": false }],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "tecnico.test",
      "enabled": true,
      "emailVerified": true,
      "email": "tecnico.test@campuslab.local",
      "firstName": "Tecnico",
      "lastName": "Test",
      "credentials": [{ "type": "password", "value": "Campuslab#2026", "temporary": false }],
      "realmRoles": ["TECNICO"]
    },
    {
      "username": "estudiante.test",
      "enabled": true,
      "emailVerified": true,
      "email": "estudiante.test@campuslab.local",
      "firstName": "Estudiante",
      "lastName": "Test",
      "credentials": [{ "type": "password", "value": "Campuslab#2026", "temporary": false }],
      "realmRoles": ["ESTUDIANTE"]
    },
    {
      "username": "auditor.test",
      "enabled": true,
      "emailVerified": true,
      "email": "auditor.test@campuslab.local",
      "firstName": "Auditor",
      "lastName": "Test",
      "credentials": [{ "type": "password", "value": "Campuslab#2026", "temporary": false }],
      "realmRoles": ["AUDITOR"]
    }
  ]
}
