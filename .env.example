# CampusLab — variables de entorno
#
# Copiar a `.env` en cada contexto donde se use (raiz para docker compose,
# y/o exportar en el shell local al levantar un servicio con ./mvnw o npm run dev).
# Este archivo NUNCA debe llevar valores reales: solo nombres y placeholders vacios
# o de ejemplo evidentemente falsos.

# ---------------------------------------------------------------------------
# infra/mq — RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Solo perfil "deploy" (cluster de 2 nodos): cookie Erlang compartida entre nodos.
RABBITMQ_ERLANG_COOKIE=

# Slice 5 (messaging-notify.md §7 A05): ms-campuslab-mq-admin, ms-campuslab-notify y
# ms-campuslab-bookings todos hablan AMQP con este mismo broker, reusando las credenciales
# RABBITMQ_USER/RABBITMQ_PASSWORD ya definidas arriba (mismo patron que CATALOG_SERVICE_URL
# - un nombre de variable reusado entre bloques de servicio en vez de uno distinto por
# consumidor). Bajo infra/apps/compose.yml, RABBITMQ_HOST/RABBITMQ_PORT ya se fijan ahi
# mismo (rabbitmq / 5672, el nombre de servicio+puerto del perfil "local" de
# infra/mq/compose.yml) y no necesitan entrada aqui salvo para quien corra estos tres
# servicios directo en el host con ./mvnw (no via compose), en cuyo caso "rabbitmq" no es
# un hostname resoluble fuera de la red compartida campuslab-net.
RABBITMQ_HOST=
RABBITMQ_PORT=

# ---------------------------------------------------------------------------
# infra/apps — Postgres por servicio (uno por microservicio que persiste)
# ---------------------------------------------------------------------------
BOOKINGS_DB_NAME=
BOOKINGS_DB_USER=
BOOKINGS_DB_PASSWORD=

CATALOG_DB_NAME=
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=

REPORT_DB_NAME=
REPORT_DB_USER=
REPORT_DB_PASSWORD=

AUDIT_DB_NAME=
AUDIT_DB_USER=
AUDIT_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cada microservicio Spring Boot (ms-campuslab-*) — leidas por su application.yml
# cuando se ejecuta fuera de docker compose (docker compose ya las inyecta arriba)
# ---------------------------------------------------------------------------
SERVER_PORT=8080
# Solo los 4 servicios que persisten (bookings, catalog, report, audit):
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Identidad — Entra ID (Azure AD) es el unico proveedor de identidad, en todo entorno
# (docs/DECISIONES_PROFESOR.md #6): sin proveedor local, sin rama de codigo por emisor.
# OIDC_ISSUER_URI: https://login.microsoftonline.com/<TENANT_ID>/v2.0
# OIDC_AUDIENCE: api://<API_CLIENT_ID>
OIDC_ISSUER_URI=
OIDC_AUDIENCE=
# Lista explicita de origenes separados por coma (nunca "*"). Ej. local: http://localhost:5173
CORS_ALLOWED_ORIGINS=

# ms-campuslab-bff (slice 2 - catalogo) y, desde slice 4 (approval saga), tambien
# ms-campuslab-bookings (que llama a catalog directamente para coordinar stock en la
# aprobacion): URL interna de ms-campuslab-catalog, el mismo valor para ambos servicios
# (docs/designs/approval-saga.md §7 A05 - no hay mas de un catalog en esta arquitectura,
# asi que un nombre distinto por servicio solo duplicaria el mismo valor sin beneficio).
# Bajo infra/apps/compose.yml esto ya se fija en el compose file mismo (http://catalog:8080,
# igual que DB_URL para los servicios con base de datos) y no necesita este valor. Se lista
# aqui solo como placeholder para quien corra el BFF o bookings directo en el host con
# ./mvnw (no via compose): en ese caso "catalog" no es un hostname resoluble fuera de la
# red de compose, asi que hay que apuntar a una instancia de catalog corriendo tambien en
# el host, ej. CATALOG_SERVICE_URL=http://localhost:8082 (con catalog arrancado con
# SERVER_PORT=8082).
CATALOG_SERVICE_URL=

# Solo ms-campuslab-bookings (slice 4 - approval saga): timeouts del cliente HTTP hacia
# ms-campuslab-catalog, para que "catalog no disponible" sea un fallo acotado y
# determinista (503) en vez de una espera indefinida. Bajo infra/apps/compose.yml y en
# application.yml ya tienen valores por defecto (2000/5000 ms) si se dejan vacios.
CATALOG_CLIENT_CONNECT_TIMEOUT_MS=
CATALOG_CLIENT_READ_TIMEOUT_MS=

# Solo ms-campuslab-bff (slice 3 - reservas): URL interna de ms-campuslab-bookings.
# Bajo infra/apps/compose.yml esto ya se fija en el compose file mismo (http://bookings:8080,
# igual que DB_URL para los servicios con base de datos) y no necesita este valor. Se lista
# aqui solo como placeholder para quien corra el BFF directo en el host con ./mvnw (no via
# compose): en ese caso "bookings" no es un hostname resoluble fuera de la red de compose,
# asi que hay que apuntar a una instancia de bookings corriendo tambien en el host, ej.
# BOOKINGS_SERVICE_URL=http://localhost:8083 (con bookings arrancado con SERVER_PORT=8083).
BOOKINGS_SERVICE_URL=

# Solo ms-campuslab-bff (slice 5 - messaging-notify.md): URL interna de
# ms-campuslab-mq-admin. Bajo infra/apps/compose.yml esto ya se fija en el compose file
# mismo (http://mq-admin:8080, igual que CATALOG_SERVICE_URL/BOOKINGS_SERVICE_URL) y no
# necesita este valor. Se lista aqui solo como placeholder para quien corra el BFF directo
# en el host con ./mvnw (no via compose): ej. MQ_ADMIN_SERVICE_URL=http://localhost:8084
# (con mq-admin arrancado con SERVER_PORT=8084).
MQ_ADMIN_SERVICE_URL=

# ---------------------------------------------------------------------------
# infra/kafka + slice 6 (kafka-audit.md) — Kafka
# ---------------------------------------------------------------------------
# ms-campuslab-bookings/ms-campuslab-kafka-admin/ms-campuslab-audit todos hablan Kafka
# con el mismo broker. Bajo infra/apps/compose.yml esto ya se fija en el compose file
# mismo (kafka:9092, el nombre de servicio+puerto del perfil "local" de
# infra/kafka/compose.yml) y no necesita entrada aqui salvo para quien corra estos tres
# servicios directo en el host con ./mvnw (no via compose).
KAFKA_BOOTSTRAP_SERVERS=

# Solo ms-campuslab-kafka-admin (kafka-audit.md §5.1): el unico valor de topologia que
# difiere entre perfiles - "1" para el perfil "local" (broker unico) y "3" para "deploy"
# (cluster de 3 brokers). Un valor equivocado en "local" hace fallar la creacion de
# topicos con InvalidReplicationFactorException (kafka-audit.md §5.1).
KAFKA_TOPIC_REPLICATION_FACTOR=

# Solo ms-campuslab-bff (kafka-audit.md): URL interna de ms-campuslab-kafka-admin. Bajo
# infra/apps/compose.yml esto ya se fija en el compose file mismo (http://kafka-admin:8080)
# y no necesita este valor. Se lista aqui solo como placeholder para quien corra el BFF
# directo en el host con ./mvnw (no via compose).
KAFKA_ADMIN_SERVICE_URL=

# Solo ms-campuslab-bff (kafka-audit.md): URL interna de ms-campuslab-audit. Bajo
# infra/apps/compose.yml esto ya se fija en el compose file mismo (http://audit:8080) y
# no necesita este valor. Se lista aqui solo como placeholder para quien corra el BFF
# directo en el host con ./mvnw (no via compose).
AUDIT_SERVICE_URL=

# Solo ms-campuslab-bff (slice 7 - reporting.md): URL interna de ms-campuslab-report.
# Bajo infra/apps/compose.yml esto ya se fija en el compose file mismo
# (http://report:8080) y no necesita este valor. Se lista aqui solo como placeholder
# para quien corra el BFF directo en el host con ./mvnw (no via compose).
REPORT_SERVICE_URL=

# ---------------------------------------------------------------------------
# frontend-campuslab — Vite expone solo variables con prefijo VITE_. MSAL es la
# unica implementacion, siempre (VITE_OIDC_AUTHORITY: https://login.microsoftonline.com/<TENANT_ID>/v2.0).
# ---------------------------------------------------------------------------
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_API_SCOPE=
VITE_API_BASE_URL=
