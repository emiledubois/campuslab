# CampusLab — variables de entorno
#
# Copiar a `.env` en cada contexto donde se use (raiz para docker compose,
# y/o exportar en el shell local al levantar un servicio con ./mvnw o npm run dev).
# Este archivo NUNCA debe llevar valores reales: solo nombres y placeholders vacios
# o de ejemplo evidentemente falsos.

# ---------------------------------------------------------------------------
# infra/identity — Keycloak (emisor OIDC local, equivalente a Azure AD en despliegue)
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# infra/mq — RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Solo perfil "deploy" (cluster de 2 nodos): cookie Erlang compartida entre nodos.
RABBITMQ_ERLANG_COOKIE=

# ---------------------------------------------------------------------------
# infra/apps — Postgres por servicio (uno por microservicio que persiste)
# ---------------------------------------------------------------------------
BOOKINGS_DB_NAME=
BOOKINGS_DB_USER=
BOOKINGS_DB_PASSWORD=

CATALOG_DB_NAME=
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=

REPORT_DB_NAME=
REPORT_DB_USER=
REPORT_DB_PASSWORD=

AUDIT_DB_NAME=
AUDIT_DB_USER=
AUDIT_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Cada microservicio Spring Boot (ms-campuslab-*) — leidas por su application.yml
# cuando se ejecuta fuera de docker compose (docker compose ya las inyecta arriba)
# ---------------------------------------------------------------------------
SERVER_PORT=8080
# Solo los 4 servicios que persisten (bookings, catalog, report, audit):
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Identidad (se agregan en la slice 1 - auth spine; se listan aqui para que el
# .env.example quede completo desde el arranque). El mapeo de claim de roles
# difiere entre Keycloak (realm_access.roles) y Azure AD (roles): es config, no codigo.
OIDC_ISSUER_URI=
OIDC_AUDIENCE=
OIDC_ROLES_CLAIM=

# ---------------------------------------------------------------------------
# frontend-campuslab — Vite expone solo variables con prefijo VITE_
# (se completan en la slice 1 una vez resuelto el enfoque MSAL/Keycloak local)
# ---------------------------------------------------------------------------
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_API_SCOPE=
VITE_API_BASE_URL=
