# frontend-campuslab — Vite solo expone variables con prefijo VITE_.
# Copiar a frontend-campuslab/.env (ignorado por git) y completar.

# URL del backend. Local: el BFF directo. Con API Gateway: la invoke URL.
VITE_API_BASE_URL=http://localhost:8080

# --- Entra ID (ruta normal, cuando exista el tenant) ---
# VITE_OIDC_AUTHORITY va SIN /v2.0: MSAL agrega el sufijo por su cuenta.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_API_SCOPE=

# --- Modo demo local (docs/DEMO_LOCAL.md) ---
# Solo mientras no exista el tenant. Con "demo", el login usa mock-jwks en vez de MSAL.
# Dejar vacio o borrar la linea para volver al comportamiento normal con Entra.
VITE_AUTH_MODE=
