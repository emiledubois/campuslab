# Java / Maven (per-service .gitignore also covers this; kept here too for the pre-subtree-split monorepo stage)
target/
*.class
.mvn/wrapper/maven-wrapper.jar

# Node / frontend
node_modules/
dist/
coverage/

# Env files — never commit real values
.env
.env.*.local
*.local

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Docker volumes materialized locally (if any bind-mounts are used for dev)
infra/**/data/

# Local-only project/AI-workflow material — never part of the submitted repo
/.claude/
/CLAUDE.md
/BOOTSTRAP_PROMPT.md
